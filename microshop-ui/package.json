{
  "name": "microshop-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "gen:all": "npm run gen:identity && npm run gen:stock && npm run gen:basket && npm run gen:order && npm run gen:payment",
    "gen:identity": "openapi-generator-cli generate -i http://localhost:5005/swagger/v1/swagger.json -g typescript-angular -o src/app/api/identity --additional-properties=fileNaming=kebab-case",
    "gen:stock": "openapi-generator-cli generate -i http://localhost:5002/swagger/v1/swagger.json -g typescript-angular -o src/app/api/stock --additional-properties=fileNaming=kebab-case",
    "gen:basket": "openapi-generator-cli generate -i http://localhost:5004/swagger/v1/swagger.json -g typescript-angular -o src/app/api/basket --additional-properties=fileNaming=kebab-case",
    "gen:order": "openapi-generator-cli generate -i http://localhost:5001/swagger/v1/swagger.json -g typescript-angular -o src/app/api/order --additional-properties=fileNaming=kebab-case",
    "gen:payment": "openapi-generator-cli generate -i http://localhost:5003/swagger/v1/swagger.json -g typescript-angular -o src/app/api/payment --additional-properties=fileNaming=kebab-case"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/platform-server": "^21.0.3",
    "@angular/router": "^18.2.0",
    "@angular/ssr": "^21.0.2",
    "chart.js": "^4.5.1",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primeng": "^17.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.4"
  }
}
